[Unit]
Description=SPanel Autonomous Self-Healing Service Watchdog
After=network.target

[Service]
Type=oneshot
User=spanel
Group=spanel
WorkingDirectory=/opt/spanel/backend
Environment=PYTHONPATH=/opt/spanel/backend
EnvironmentFile=-/opt/spanel/backend/.env
ExecStart=/opt/spanel/backend/.venv/bin/python -m app.services.system
StandardOutput=journal
StandardError=journal
