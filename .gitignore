# Env / secrets
#
# Widened after run-1 of the security audit, which found this list covered
# .env and .env.local but not the other .env.* spellings, and covered *.pem
# and *.key but not the certificate, keystore or SSH key-file extensions.
# token.txt is here because one was left in the working tree during that run,
# unignored, while `git add -A` was being used - it survived on ordering alone.
.env
.env*.local
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
id_ecdsa
token.txt
*.token
credentials.json
secrets.json

# Tooling index, built from this repository. The .zst suffix slipped past the
# *.db rule below, which is how a 1.6 MB copy came to be tracked.
.codebase-memory/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
.kiro/

# Build artifacts
*.bak
*.tar.gz
backup/

# SPanel runtime
backend/spanel.db

# Landing page
landing.html
style.css

# Dev / CI / tooling (not part of release)
.codex/
# NOT .github/ - the workflows and the dependabot config have to be committed
# for GitHub to run them at all. The two files there today predate the rule and
# survive only because tracked files ignore .gitignore; a *new* workflow would
# have been skipped by `git add` without saying why.
.ruff_cache/
.vendor/
skills/
prompts/

# Scripts not part of setup
check.py
patch*.py
do_patch.py
fix_include.py
remote_fix.py
test_ssh.py
setup.sh
change_IP.sh

# Internal audit/plan reports (tests/ is tracked: CI runs it)
plan-report/
BAO_CAO_DANH_GIA_ENTERPRISE_SPANEL.doc

# Misc
images.zip

# Playwright MCP session output and design survey screenshots: local only.
.playwright-mcp/
shots/
