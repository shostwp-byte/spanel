  "info": {
    "description": "Billing-system API for creating and managing hosting accounts. Authenticate with `Authorization: Bearer <token>`; write calls accept an `Idempotency-Key` header. See docs/API_AND_WHMCS.md.",
    "title": "SPanel Provisioning API",
    "version": "1.0.7"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/provisioning/v1/accounts": {
      "get": {
        "description": "Accounts this panel provisioned, for WHMCS ListAccounts / GetUserCount.\n\nWithout ``status`` the list holds the accounts that exist on the server\n(active, suspended, pending); ``status=all`` adds failed and terminated\nrecords.",
        "operationId": "list_accounts_api_provisioning_v1_accounts_get",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Per Page",
              "type": "integer"
            }
          },
          {
            "description": "active, suspended, pending, failed, terminated, or all",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "default": "",
              "description": "active, suspended, pending, failed, terminated, or all",
              "maxLength": 32,
              "title": "Status",
              "type": "string"
            }
          },
          {
            "description": "Substring of external_id or username",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "description": "Substring of external_id or username",
              "maxLength": 255,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisioningAccountList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Accounts",
        "tags": [
          "provisioning"
        ]
      },
      "post": {
        "operationId": "create_account_api_provisioning_v1_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisioningAccountCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisioningAccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Account",
        "tags": [
          "provisioning"
        ]
      }
    },
    "/api/provisioning/v1/accounts/usage": {
      "get": {
        "operationId": "get_all_usage_api_provisioning_v1_accounts_usage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProvisioningUsageOut"
                  },
                  "title": "Response Get All Usage Api Provisioning V1 Accounts Usage Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get All Usage",
        "tags": [
          "provisioning"
        ]
      }
    },
    "/api/provisioning/v1/accounts/{external_id}": {
      "delete": {
        "description": "Delete a provisioned account.\n\n``backup`` defaults to off: the backup runs inside this request, and a\nbilling module that gives the call a short HTTP timeout would report a\nfailure while the server kept working. Pass ``?backup=true`` when the\ncaller can wait for a full account archive.",
        "operationId": "terminate_api_provisioning_v1_accounts__external_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "external_id",
            "required": true,
            "schema": {
              "title": "External Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "backup",
            "required": false,
            "schema": {
              "default": false,
              "title": "Backup",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Terminate",
        "tags": [
          "provisioning"
        ]
      },
      "get": {
        "operationId": "get_account_api_provisioning_v1_accounts__external_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "external_id",
