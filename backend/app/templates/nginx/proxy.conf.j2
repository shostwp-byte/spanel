server {
    listen {% if bind_address and bind_address != "*" %}{{ bind_address }}:{% endif %}80;
{% if ipv6 %}    listen [::]:80;
{% endif %}    server_name {{ server_names | join(' ') }};
    root {{ document_root_path }};

    server_tokens off;
    disable_symlinks if_not_owner from={{ root_path }};

{% if http_flood_enabled %}
    # SPANEL HTTP FLOOD BEGIN
    limit_req zone={{ http_flood_zone }}{% if http_flood_burst > 0 %} burst={{ http_flood_burst }}{% endif %} nodelay;
    limit_conn spanel_conn_flood {{ http_flood_connections }};
    limit_req_status 429;
    limit_conn_status 429;
{{ http_flood_challenge_block }}
    # SPANEL HTTP FLOOD END
{% endif %}

{% if waf_enabled %}
    # SPANEL WAF BEGIN
    modsecurity on;
    modsecurity_rules_file {{ waf_rules_file }};
    # SPANEL WAF END
{% endif %}

    access_log /var/log/nginx/{{ domain }}.access.log;
    error_log /var/log/nginx/{{ domain }}.error.log;

    client_max_body_size 1100M;

    # SPANEL ACME CHALLENGE
    # Served from disk, ahead of the proxy, so certificate renewal never depends
    # on the application being up.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/spanel-acme;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        auth_basic off;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

    autoindex off;

    location ~ /\.(?!well-known) {
        deny all;
    }

    # SPANEL CUSTOM INCLUDE
    include {{ custom_include_path }};

    # SPANEL PROXY BEGIN
    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;

        # WebSocket upgrade. $connection_upgrade comes from the map in
        # /etc/nginx/conf.d/00-spanel-upgrade-map.conf.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_redirect off;
        # Off so server-sent events and long-polling reach the browser as they
        # happen instead of sitting in a buffer.
        proxy_buffering off;
        proxy_request_buffering off;

        proxy_connect_timeout 30s;
        proxy_send_timeout {{ proxy_timeout }}s;
        proxy_read_timeout {{ proxy_timeout }}s;
    }
    # SPANEL PROXY END
}
